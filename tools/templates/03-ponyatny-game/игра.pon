# Мини-игра: двигайте платформу стрелками ← → (или пальцем) и ловите мяч.
# Работает в Строке, в собранном APK и в песочнице «Понятного».

окно("Поймай мяч", 320, 240)

пусть х = 140          # левый край платформы
пусть мяч_х = 160
пусть мяч_у = 0
пусть счёт = 0

# Функция кадр рисует один кадр игры; дт — секунды с прошлого кадра
функция кадр(дт)
    если клавиша("влево") то
        х = х - 200 * дт
    конец
    если клавиша("вправо") то
        х = х + 200 * дт
    конец
    если мышь()["нажата"] то
        х = мышь()["x"] - 20
    конец
    мяч_у = мяч_у + 120 * дт
    # Мяч коснулся платформы?
    если пересекаются(х, 220, 40, 8, мяч_х - 6, мяч_у - 6, 12, 12) то
        счёт = счёт + 1
        мяч_у = 0
        мяч_х = 20 + (счёт * 70) % 280
    иначе если мяч_у > 240 то
        мяч_у = 0
    конец
    залей("чёрный")
    прямоугольник(х, 220, 40, 8, "белый")
    круг(мяч_х, мяч_у, 6, "жёлтый")
    рисуй_текст(10, 10, "Счёт: {счёт}", "зелёный", 16)
конец

# каждый_кадр вызывает функцию примерно 60 раз в секунду
каждый_кадр(кадр)
