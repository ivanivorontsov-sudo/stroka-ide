# Первая программа на «Понятном».
# Нажмите «Старт» и ответьте на вопрос в окне ввода.

# спроси() показывает окно ввода и возвращает ответ
пусть имя = спроси("Как тебя зовут?")
пиши "Привет, " + имя + "!"

# Функция получает число и возвращает его квадрат
функция квадрат(н)
    верни н * н
конец

# Цикл: н принимает значения 1, 2, 3, 4, 5
для н от 1 до 5
    пиши н, "в квадрате =", квадрат(н)
конец

# Список чисел и встроенные функции сумма() и длина()
пусть оценки = [5, 4, 5, 3]
пиши "Средняя оценка:", округли(сумма(оценки) / длина(оценки), 2)
