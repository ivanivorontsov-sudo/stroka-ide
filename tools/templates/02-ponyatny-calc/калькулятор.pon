# Калькулятор на «Понятном».
# Если в программе есть функции сложить, вычесть, умножить и разделить,
# Строка сама рисует окно с двумя полями и кнопками «+ − × ÷».
# Нажмите «Старт» или соберите APK/EXE — получится настоящее приложение.

функция сложить(а, б)
    верни а + б
конец

функция вычесть(а, б)
    верни а - б
конец

функция умножить(а, б)
    верни а * б
конец

функция разделить(а, б)
    # На ноль делить нельзя — вернём понятное сообщение вместо ошибки
    если б == 0 то
        верни "Деление на ноль"
    конец
    верни а / б
конец
